# Lista cerrada: solo se versiona lo enumerado. Cualquier archivo nuevo debe revisarse
# (docs/revision_divulgacion.md), añadirse aquí si procede y registrarse en el manifiesto.
/*
!/.gitignore
!/README.md
!/CITATION.cff
!/renv.lock
!/manifiesto_permitidos.json
!/config/
!/docs/
!/scripts/
!/results/

# Datos y objetos privados: nunca, en ningún directorio ni formato
private_data/
renv/
.venv/
**/__pycache__/
*.xlsx
*.xls
